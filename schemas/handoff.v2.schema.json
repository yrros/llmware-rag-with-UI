{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-notes-handoff/v2",
  "title": "LLM Notes handoff package (v2)",
  "description": "Version 2 of the outbox package: everything in v1, plus 'update' items that change one field of an existing record, and 'mixed' packages whose items have different types (e.g. a Next Step update and its chase task). Connectors that read v1 keep working; v1 packages are unchanged. Unknown values are empty strings, never guesses.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "created",
    "item_type",
    "source",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "llm-notes-handoff/v2"
    },
    "id": {
      "type": "string",
      "description": "Unique package id. Connectors must treat it as an idempotency key: processing the same id twice must not create duplicate records."
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Local time the package was sent, ISO 8601."
    },
    "item_type": {
      "enum": [
        "note",
        "task",
        "email",
        "update",
        "mixed"
      ],
      "description": "Every entry in items has this type, or 'mixed' when they differ."
    },
    "source": {
      "type": "object",
      "required": [
        "library",
        "library_key",
        "question",
        "prompt",
        "model",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "library": {
          "type": "string",
          "description": "Corpus display name, e.g. the notes folder name."
        },
        "library_key": {
          "type": "string",
          "description": "Sanitised library name used by the app's index."
        },
        "question": {
          "type": "string",
          "description": "The question asked, or empty if the task ran on its own."
        },
        "prompt": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "model": {
          "type": "string",
          "description": "Ollama model that drafted the items."
        },
        "notes": {
          "type": "array",
          "description": "Source notes the drafts were written from.",
          "items": {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "description": "File name as indexed."
              },
              "path": {
                "type": "string",
                "description": "Absolute path on the machine that sent the package, if known."
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/note"
          },
          {
            "$ref": "#/$defs/task"
          },
          {
            "$ref": "#/$defs/email"
          },
          {
            "$ref": "#/$defs/update"
          }
        ]
      }
    }
  },
  "$defs": {
    "related_to": {
      "type": "object",
      "description": "Name hint for the record this belongs to. Connectors resolve it to an ID (e.g. a Salesforce Opportunity); the app never knows IDs.",
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "e.g. 'Acme pilot', or empty if unknown."
        },
        "kind": {
          "enum": [
            "",
            "opportunity",
            "account",
            "contact"
          ]
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "type",
        "title",
        "body",
        "related_to"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "note"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "related_to": {
          "$ref": "#/$defs/related_to"
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "type",
        "subject",
        "description",
        "due_date",
        "priority",
        "owner",
        "related_to"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "task"
        },
        "subject": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "due_date": {
          "type": "string",
          "description": "YYYY-MM-DD, or empty if the notes give no date."
        },
        "priority": {
          "enum": [
            "",
            "low",
            "normal",
            "high"
          ]
        },
        "owner": {
          "type": "string",
          "description": "Person responsible as named in the notes, or empty."
        },
        "related_to": {
          "$ref": "#/$defs/related_to"
        }
      }
    },
    "email": {
      "type": "object",
      "required": [
        "type",
        "to",
        "subject",
        "body",
        "related_to"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "email"
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recipient names or addresses as given in the notes."
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "related_to": {
          "$ref": "#/$defs/related_to"
        }
      }
    },
    "update": {
      "type": "object",
      "description": "Set one field of the record named in related_to to value. previous is the value the user saw when staging; when present, connectors apply the change only if the field still holds it.",
      "required": [
        "type",
        "field",
        "value",
        "related_to"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "update"
        },
        "field": {
          "enum": [
            "next_step"
          ],
          "description": "Logical field; next_step is an opportunity's next step."
        },
        "value": {
          "type": "string",
          "description": "The new value, exactly as it should be written."
        },
        "previous": {
          "type": "string",
          "description": "The value when the update was staged (may be empty)."
        },
        "related_to": {
          "$ref": "#/$defs/related_to"
        }
      }
    }
  }
}
